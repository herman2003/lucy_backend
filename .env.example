PORT=3001
NODE_ENV=development
FIREBASE_PROJECT_ID=lucy-7504c
# Default bucket: {FIREBASE_PROJECT_ID}.appspot.com — only when STORAGE_PROVIDER=firebase
# FIREBASE_STORAGE_BUCKET=lucy-7504c.appspot.com

# Document binaries: cloudflare R2 (no Firebase Blaze required) or firebase (default)
STORAGE_PROVIDER=r2
R2_BUCKET=lucy
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# EU endpoint from Cloudflare dashboard (or omit if R2_ACCOUNT_ID is set)
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# GOOGLE_APPLICATION_CREDENTIALS=./lucy-7504c-firebase-adminsdk-fbsvc-27c933a9f1.json

# gemini = production-like ; mock = local dev without GEMINI_API_KEY
LLM_PROVIDER=mock

# Flutter E2E (real Firebase Auth + Firestore):
FIREBASE_AUTH_MODE=firebase
FIRESTORE_PROVIDER=firebase

# Local stack without Firebase service account (development only):
# FIREBASE_AUTH_MODE=dev
# FIRESTORE_PROVIDER=memory
# Or run: npm run start:dev:local

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Document RAG embeddings — always Gemini (not affected by LLM_PROVIDER=mock)
# text-embedding-004 is deprecated on the API (404); use gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated Lucy web origins (prod/staging). localhost / 127.0.0.1 always allowed in dev.
# CORS_ALLOWED_ORIGINS=https://app.lucy.example,https://lucy.web.app
